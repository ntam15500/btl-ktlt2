int readChoice(const string& prompt, int low, int high) {
    while (true) {
        cout << prompt; int x;
        if (cin >> x && x >= low && x <= high) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n'); return x;
        }
        cout << "Lua chon khong hop le.\n";
        cin.clear(); cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

// ===== Template: CRUD va luu file dung chung cho 10 Use Case =====
template<class T>
class Repository {
private:
    vector<T> items;
    string file;
public:
    explicit Repository(string path) : file(move(path)) {
        ifstream test(file);
        if (!test) { ofstream create(file); if (!create) throw runtime_error("Khong tao duoc file " + file); }
        load();
    }
    void load() {
        items.clear(); ifstream in(file);
        if (!in) throw runtime_error("Khong mo duoc file " + file);
        string line;
        while (getline(in, line)) {
            T x;
            if (!line.empty() && x.parse(line)) items.push_back(x);
            else if (!line.empty()) cerr << "Canh bao: dong du lieu loi trong " << file << '\n';
        }
    }
    void save() const {
        ofstream out(file, ios::trunc);
        if (!out) throw runtime_error("Khong ghi duoc file " + file);
        for (const auto& x : items) out << x.serialize() << '\n';
        if (!out) throw runtime_error("Loi khi ghi file " + file);
    }
    T* find(const string& id) {
        auto it = find_if(items.begin(), items.end(), [&](const T& x){ return x.getId()==id; });
        return it == items.end() ? nullptr : &*it;
    }
    void run(const string& title) {
        while (true) {
            cout << "\n" << string(58, '=') << "\n"
                 << "                 " << title << "\n"
                 << string(58, '=') << "\n"
                 << "  1. Them moi\n  2. Xem danh sach\n"
                 << "  3. Tim kiem / xem chi tiet\n"
                 << "  4. Cap nhat thong tin\n  5. Xoa ban ghi\n"
                 << "  0. Quay lai menu chinh\n"
                 << string(58, '-') << "\n";
            int c = readChoice("Chon: ", 0, 5);
            try {
                if (c == 0) return;
                if (c == 1) {
                    T x; x.inputNew();
                    if (find(x.getId())) throw invalid_argument("Ma da ton tai.");
                    items.push_back(x); save(); cout << "Them thanh cong.\n";
                } else if (c == 2) {
                    if (items.empty()) { cout << "Danh sach rong.\n"; continue; }
                    cout << "\n" << left << setw(14) << "MA DINH DANH";
                    for (const auto& label : items[0].labels())
                        cout << left << setw(22) << label;
                    cout << "\n" << string(14 + 22 * items[0].labels().size(), '-') << "\n";
                    for (const auto& item : items) item.show();
                    cout << string(14 + 22 * items[0].labels().size(), '-') << "\n"
                         << "Tong so ban ghi: " << items.size() << "\n";
                } else {
                    string id = Entity::read("Nhap ma: ");
                    T* x = find(id);
                    if (!x) { cout << "Khong tim thay.\n"; continue; }
                    x->detail();
                    if (c == 3) continue;
                    if (c == 4) {
                        x->updateFields(); save(); cout << "Cap nhat thanh cong.\n";
                    } else if (c == 5) {
                        string yn = Entity::read("Xac nhan xoa (y/n): ");
                        if (yn == "y" || yn == "Y") {
                            // TODO nghiep vu: kiem tra rang buoc tham chieu truoc khi xoa.
                            items.erase(remove_if(items.begin(), items.end(),
                                [&](const T& a){ return a.getId()==id; }), items.end());
                            save(); cout << "Da xoa.\n";
                        } else cout << "Da huy.\n";
                    }
                }
            } catch (const exception& e) {
                cout << "Loi: " << e.what() << '\n';
            }
        }
    }
};

