int readChoice(const string& prompt, int minValue, int maxValue) {
    while (true) {
        cout << prompt;
        int choice;
        if (cin >> choice && choice >= minValue && choice <= maxValue) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return choice;
        }
        cout << "Lua chon khong hop le, vui long nhap lai.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

