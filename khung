/* --- CAC HAM TIEN ICH & KIEM TRA DU LIEU (INLINE) --- */
inline string readLine(const string& prompt) {
    cout << prompt;
    string s;
    getline(cin >> ws, s);
    return s;
}

inline int readChoice(const string& prompt, int minVal, int maxVal) {
    while (true) {
        try {
            int c = stoi(readLine(prompt));
            if (c >= minVal && c <= maxVal) return c;
        } catch (...) {}
        cout << "Lua chon khong hop le, vui long nhap lai.\n";
    }
}

inline bool isValidCode(const string& s, const string& pre) {
    if (s.size() <= pre.size() || s.substr(0, pre.size()) != pre) return false;
    for (size_t i = pre.size(); i < s.size(); ++i)
        if (!isdigit(s[i])) return false;
    return true;
}

inline bool isValidDate(const string& s) {
    if (s.size() != 10 || s[2] != '/' || s[5] != '/') return false;
    for (int i = 0; i < 10; ++i)
        if (i != 2 && i != 5 && !isdigit(s[i])) return false;
    int d = stoi(s.substr(0, 2)), m = stoi(s.substr(3, 2)), y = stoi(s.substr(6, 4));
    if (y < 2000 || y > 2100 || m < 1 || m > 12 || d < 1) return false;
    int days[] = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    if ((y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)) days[2] = 29;
    return d <= days[m];
}

inline bool isPositiveNum(const string& s) {
    try {
        size_t idx = 0;
        double v = stod(s, &idx);
        return !s.empty() && idx == s.size() && v > 0;
    } catch (...) { return false; }
}

/* --- LOP CO SO TRUU TUONG ENTITY --- */
class Entity {
protected:
    string id_, type_;
    vector<string> fields_, labels_;

public:
    Entity(string type = "", vector<string> labels = {})
        : id_(""), type_(type), fields_(labels.size(), ""), labels_(labels) {}
    virtual ~Entity() {}

    string getId() const { return id_; }
    const vector<string>& getLabels() const { return labels_; }

    void setId(const string& id) {
        if (id.empty() || id.find('|') != string::npos)
            throw invalid_argument("Ma dinh danh rong hoac chua ky tu '|'.");
        id_ = id;
    }

    virtual void validate() const = 0; // Ham thuan ao

    /* Da nang hoa toan tu == de so sanh ma dinh danh */
    bool operator==(const string& otherId) const { return id_ == otherId; }

    virtual void inputNew() {
        setId(readLine("Nhap ma " + type_ + ": "));
        for (size_t i = 0; i < labels_.size(); ++i)
            fields_[i] = readLine(labels_[i] + ": ");
        validate();
    }

    virtual void updateFields() {
        for (size_t i = 0; i < labels_.size(); ++i) {
            cout << labels_[i] << " [" << fields_[i] << "] (Enter de giu nguyen): ";
            string v;
            getline(cin, v);
            if (!v.empty()) fields_[i] = v;
        }
        validate();
    }

    virtual void displayRow() const {
        cout << left << setw(14) << id_;
        for (size_t i = 0; i < fields_.size(); ++i)
            cout << left << setw(22) << fields_[i];
        cout << '\n';
    }

    string serialize() const {
        string s = id_;
        for (size_t i = 0; i < fields_.size(); ++i) s += "|" + fields_[i];
        return s;
    }

    bool parse(const string& line) {
        stringstream ss(line);
        string p;
        vector<string> parts;
        while (getline(ss, p, '|')) parts.push_back(p);
        if (parts.size() != labels_.size() + 1) return false;
        try {
            setId(parts[0]);
            for (size_t i = 0; i < labels_.size(); ++i) fields_[i] = parts[i + 1];
            validate();
            return true;
        } catch (...) { return false; }
    }
};

/* --- CAC LOP THUC THE CON --- */
class SimpleEntity : public Entity {
public:
    SimpleEntity(string type, vector<string> labels) : Entity(type, labels) {}
    void validate() const override {
        for (size_t i = 0; i < fields_.size(); ++i)
            if (fields_[i].find('|') != string::npos)
                throw invalid_argument("Du lieu khong duoc chua ky tu '|'.");
    }
};

