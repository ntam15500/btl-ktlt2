class Invoice : public Entity {
public:
    Invoice() : Entity("Hoa don cuoc", {
        "Ma khach hang", "Ky cuoc", "Ngay lap", "Tong tien", "Trang thai"
    }) {}

    string getCustomerId() const { return fields_[0]; }
    string getStatus() const { return fields_[4]; }
    void setStatus(const string& st) { fields_[4] = st; }

    void validate() const override {
        if (!isValidCode(id_, "HD")) throw invalid_argument("Ma hoa don phai co dang HDxxx.");
        if (fields_[0].empty()) throw invalid_argument("Ma khach hang khong duoc trong.");
        if (!isValidDate("01/" + fields_[1])) throw invalid_argument("Ky cuoc khong hop le (MM/YYYY).");
        if (!isValidDate(fields_[2])) throw invalid_argument("Ngay lap khong hop le (DD/MM/YYYY).");
        if (!isPositiveNum(fields_[3])) throw invalid_argument("Tong tien phai > 0.");
        string st = fields_[4];
        if (st != "Chua thanh toan" && st != "Da thanh toan" && st != "Qua han")
            throw invalid_argument("Trang thai phai la: Chua thanh toan, Da thanh toan, Qua han.");
    }
};

class Payment : public Entity {
public:
    Payment() : Entity("Thanh toan", {
        "Ma hoa don", "Ngay thanh toan", "So tien", "Phuong thuc", "Trang thai"
    }) {}

    string getInvoiceId() const { return fields_[0]; }
    string getStatus() const { return fields_[4]; }

    void validate() const override {
        if (!isValidCode(id_, "TT")) throw invalid_argument("Ma thanh toan phai co dang TTxxx.");
        if (!isValidCode(fields_[0], "HD")) throw invalid_argument("Ma hoa don tham chieu phai co dang HDxxx.");
        if (!isValidDate(fields_[1])) throw invalid_argument("Ngay thanh toan khong hop le (DD/MM/YYYY).");
        if (!isPositiveNum(fields_[2])) throw invalid_argument("So tien phai > 0.");
        string m = fields_[3], st = fields_[4];
        if (m != "Tien mat" && m != "Chuyen khoan" && m != "Vi dien tu" && m != "The")
            throw invalid_argument("Phuong thuc thanh toan khong hop le.");
        if (st != "Thanh cong" && st != "Dang xu ly" && st != "Hoan tien")
            throw invalid_argument("Trang thai thanh toan khong hop le.");
    }
};

/* --- LOP KHUON MAU QUAN LY FILE REPOSITORY --- */
template <class T>
class Repository {
    vector<T> items_;
    string path_;
public:
    Repository(string path) : path_(path) {
        ifstream in(path_.c_str());
        if (!in) { ofstream out(path_.c_str()); return; }
        string line;
        while (getline(in, line)) {
            if (line.empty()) continue;
            T item;
            if (item.parse(line)) items_.push_back(item);
        }
    }

    void save() const {
        ofstream out(path_.c_str(), ios::trunc);
        for (size_t i = 0; i < items_.size(); ++i)
            out << items_[i].serialize() << '\n';
    }

    vector<T>& all() { return items_; }

    T* findById(const string& id) {
        for (size_t i = 0; i < items_.size(); ++i)
            if (items_[i] == id) return &items_[i];
        return NULL;
    }

    void add(const T& item) { items_.push_back(item); save(); }

    bool removeById(const string& id) {
        for (size_t i = 0; i < items_.size(); ++i) {
            if (items_[i] == id) {
                items_.erase(items_.begin() + i);
                save();
                return true;
            }
        }
        return false;
    }

    void showAll() const {
        if (items_.empty()) { cout << "Danh sach rong.\n"; return; }
        const vector<string>& lbs = items_[0].getLabels();
        cout << left << setw(14) << "MA DINH DANH";
        for (size_t i = 0; i < lbs.size(); ++i) cout << left << setw(22) << lbs[i];
        cout << '\n' << string(14 + 22 * lbs.size(), '-') << '\n';
        for (size_t i = 0; i < items_.size(); ++i) {
            const Entity* e = &items_[i]; // Goi da hinh qua con tro lop co so
            e->displayRow();
        }
        cout << "Tong so ban ghi: " << items_.size() << '\n';
    }
};

