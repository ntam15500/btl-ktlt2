// ============================================================
// 1. LOP CO SO TRUU TUONG DUNG CHUNG
// ============================================================
class Entity {
private:
    string id_;

protected:
    vector<string> fields_;

public:
    virtual ~Entity() = default;

    // Getter/setter ma dinh danh; khong cho phep ma rong hoac chua ky tu phan cach.
    const string& getId() const { return id_; }

    void setId(const string& id) {
        if (id.empty() || id.find('|') != string::npos)
            throw invalid_argument("Ma dinh danh rong hoac chua ky tu |.");
        id_ = id;
    }

    // Cac ham thuan ao giup Entity la lop truu tuong.
    virtual string typeName() const = 0;
    virtual vector<string> fieldNames() const = 0;

    // Moi thanh vien can bo sung quy tac kiem tra rieng cho doi tuong.
    virtual void validate() const {
        if (id_.empty()) throw invalid_argument("Ma dinh danh khong duoc de trong.");
        for (const auto& value : fields_) {
            if (value.find('|') != string::npos)
                throw invalid_argument("Du lieu khong duoc chua ky tu |.");
        }
    }

    // Khung nhap/sua chung. Thanh vien co the ghi de neu can kieu du lieu dac thu.
    virtual void inputNew() {
        setId(readLine("Nhap ma " + typeName() + ": "));
        fields_.clear();

        for (const auto& label : fieldNames()) {
            string value = readLine(label + ": ");
            fields_.push_back(value);
        }
        validate(); // TODO theo tung use case: kiem tra so, ngay, email, trang thai...
    }

    virtual void updateFields() {
        const auto labels = fieldNames();
        for (size_t i = 0; i < fields_.size() && i < labels.size(); ++i) {
            cout << labels[i] << " [" << fields_[i]
                 << "] (Enter de giu nguyen): ";
            string value;
            getline(cin, value);
            if (!value.empty()) fields_[i] = value;
        }
        validate(); // Ma dinh danh khong duoc sua trong thao tac cap nhat.
    }

    virtual void displayRow() const {
        cout << left << setw(14) << id_;
        for (const auto& value : fields_) cout << left << setw(22) << value;
        cout << '\n';
    }

    virtual void displayDetail() const {
        cout << "Ma: " << id_ << '\n';
        const auto labels = fieldNames();
        for (size_t i = 0; i < fields_.size() && i < labels.size(); ++i)
            cout << labels[i] << ": " << fields_[i] << '\n';
    }

    // Dinh dang file van ban: ma|truong1|truong2...
    string serialize() const {
        validate();
        string line = id_;
        for (const auto& value : fields_) line += "|" + value;
        return line;
    }

    bool parse(const string& line) {
        stringstream stream(line);
        vector<string> parts;
        string part;
        while (getline(stream, part, '|')) parts.push_back(part);

        if (parts.size() != fieldNames().size() + 1 || parts.empty())
            return false;

        try {
            setId(parts[0]);
            fields_.assign(parts.begin() + 1, parts.end());
            validate();
            return true;
        } catch (...) {
            return false;
        }
    }

    static string readLine(const string& prompt) {
        cout << prompt;
        string value;
        getline(cin >> ws, value);
        return value;
    }
};

