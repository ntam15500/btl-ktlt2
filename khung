// ===== OOP: dong goi, ke thua, truu tuong, da hinh =====
class Entity {
private:
    string id;
protected:
    vector<string> data;
public:
    virtual ~Entity() = default;
    string getId() const { return id; }
    void setId(const string& s) {
        if (s.empty() || s.find('|') != string::npos)
            throw invalid_argument("Ma khong hop le.");
        id = s;
    }
    virtual string name() const = 0;
    virtual vector<string> labels() const = 0;

    virtual void validate() const {
        if (id.empty()) throw invalid_argument("Ma khong duoc de trong.");
        for (const auto& s : data)
            if (s.find('|') != string::npos)
                throw invalid_argument("Khong duoc nhap ky tu |.");
    }
    virtual void inputNew() {
        setId(read("Nhap ma: "));
        data.clear();
        for (const auto& label : labels()) {
            string s = read(label + ": ");
            if (s.empty()) throw invalid_argument(label + " khong duoc de trong.");
            data.push_back(s);
        }
        validate();
    }
    virtual void updateFields() {
        for (size_t i = 0; i < data.size(); ++i) {
            cout << labels()[i] << " [" << data[i] << "] (Enter de giu nguyen): ";
            string s; getline(cin, s);
            if (!s.empty()) data[i] = s;
        }
        validate();
    }
    virtual void show() const {
        cout << left << setw(14) << id;
        for (const auto& s : data) cout << left << setw(22) << s;
        cout << '\n';
    }
    virtual void detail() const {
        cout << "Ma: " << id << '\n';
        for (size_t i = 0; i < data.size(); ++i)
            cout << labels()[i] << ": " << data[i] << '\n';
    }
    string serialize() const {
        validate();
        string s = id;
        for (const auto& x : data) s += "|" + x;
        return s;
    }
    bool parse(const string& line) {
        stringstream ss(line); string x; vector<string> p;
        while (getline(ss, x, '|')) p.push_back(x);
        if (p.size() != labels().size() + 1 || p[0].empty()) return false;
        try {
            setId(p[0]); data.assign(p.begin()+1, p.end()); validate();
            return true;
        } catch (...) { return false; }
    }
    static string read(const string& prompt) {
        cout << prompt;
        string s; getline(cin >> ws, s); return s;
    }
};

