// 3. REPOSITORY<T> - KHUNG LUU TRU DUNG CHUNG
//    CRUD co ban duoc cung cap; rang buoc nghiep vu do thanh vien bo sung.
// ============================================================
template <class T>
class Repository {
private:
    vector<T> items_;
    string filePath_;

public:
    explicit Repository(string filePath) : filePath_(move(filePath)) {
        filesystem::path path(filePath_);
        if (path.has_parent_path())
            filesystem::create_directories(path.parent_path());

        if (!filesystem::exists(path)) {
            ofstream create(filePath_);
            if (!create) throw runtime_error("Khong tao duoc file: " + filePath_);
        }
        load();
    }

    void load() {
        items_.clear();
        ifstream input(filePath_);
        if (!input) throw runtime_error("Khong mo duoc file: " + filePath_);

        string line;
        while (getline(input, line)) {
            if (line.empty()) continue;
            T item;
            if (item.parse(line)) items_.push_back(item);
            else cerr << "Canh bao: bo qua dong loi trong " << filePath_ << '\n';
        }
    }

    void save() const {
        ofstream output(filePath_, ios::trunc);
        if (!output) throw runtime_error("Khong ghi duoc file: " + filePath_);
        for (const auto& item : items_) output << item.serialize() << '\n';
        if (!output) throw runtime_error("Loi khi ghi file: " + filePath_);
    }

    vector<T>& all() { return items_; }
    const vector<T>& all() const { return items_; }

    T* findById(const string& id) {
        auto it = find_if(items_.begin(), items_.end(),
            [&](const T& item) { return item.getId() == id; });
        return it == items_.end() ? nullptr : &(*it);
    }

    // Cac ham CRUD co ban. Bo sung kiem tra tham chieu o use case truoc khi xoa.
    bool add(const T& item) {
        if (findById(item.getId())) return false;
        items_.push_back(item);
        save();
        return true;
    }

    bool update(const string& id, const T& updated) {
        T* current = findById(id);
        if (!current) return false;
        *current = updated; // Ma cu duoc giu nguyen o lop giao dien.
        save();
        return true;
    }

    bool removeById(const string& id) {
        auto oldSize = items_.size();
        items_.erase(remove_if(items_.begin(), items_.end(),
            [&](const T& item) { return item.getId() == id; }), items_.end());
        if (items_.size() == oldSize) return false;
        save();
        return true;
    }

    void showAll() const {
        if (items_.empty()) {
            cout << "Danh sach rong.\n";
            return;
        }

        cout << left << setw(14) << "MA DINH DANH";
        for (const auto& label : items_.front().fieldNames())
            cout << left << setw(22) << label;
        cout << '\n' << string(14 + 22 * items_.front().fieldNames().size(), '-') << '\n';

        for (const auto& item : items_) item.displayRow();
        cout << "Tong so ban ghi: " << items_.size() << '\n';
    }

    // TODO NGHIEP VU: them ham tim kiem theo ten/trang thai neu use case can.
};

